rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Auth helpers =====
    function isSignedIn() {
      return request.auth != null;
    }

    function tenantId() {
      return request.auth.token.tenantId;
    }

    function isManager() {
      return isSignedIn() && (request.auth.token.role == "manager" || request.auth.token.role == "admin");
    }

    function inTenant(tid) {
      return isSignedIn() && tenantId() == tid;
    }

    // ===== Tenant root doc =====
    match /tenants/{tid} {
      // Read: any signed-in user belonging to that tenant.
      allow read: if inTenant(tid);
      // Write: managers only, and only their own tenant.
      allow update: if inTenant(tid) && isManager();
      // Create/delete: server-only (Admin SDK bypasses rules).
      allow create, delete: if false;

      // ===== Tenant-scoped subcollections =====
      // Default rule for all subcollections under tenants/{tid}/...
      // Each new collection should also explicitly enforce inTenant(tid).
      match /leads/{leadId} {
        allow read, write: if inTenant(tid);

        match /activities/{activityId} {
          allow read, write: if inTenant(tid);
        }
        match /tasks/{taskId} {
          allow read, write: if inTenant(tid);
        }
      }

      match /pipelines/{pipelineId} {
        allow read: if inTenant(tid);
        allow write: if inTenant(tid) && isManager();

        match /stages/{stageId} {
          allow read: if inTenant(tid);
          allow write: if inTenant(tid) && isManager();
        }
      }

      match /imports/{importId} {
        allow read, write: if inTenant(tid);
      }

      match /notifications/{notificationId} {
        allow read, write: if inTenant(tid);
      }

      match /cadences/{cadenceId} {
        allow read: if inTenant(tid);
        allow write: if inTenant(tid) && isManager();
      }

      match /cadenceEnrollments/{enrollmentId} {
        allow read, write: if inTenant(tid);
      }

      match /templates/{templateId} {
        allow read: if inTenant(tid);
        allow write: if inTenant(tid) && isManager();
      }

      match /integrations/{provider} {
        // API keys live here — managers only, never readable by non-managers.
        allow read, write: if inTenant(tid) && isManager();
      }
    }

    // ===== Top-level collections =====
    match /users/{userId} {
      // Users can read their own record; managers can read users in their tenant.
      allow read: if isSignedIn() && (request.auth.uid == userId
        || (isManager() && resource.data.tenantId == tenantId()));
      allow update: if request.auth.uid == userId;
      allow create, delete: if false; // server-side via Admin SDK
    }

    match /subdomains/{slug} {
      // Public read so middleware can resolve {firm}.sequence-ai.com → tenantId.
      allow read: if true;
      // Only server may write (Admin SDK).
      allow write: if false;
    }

    // ===== Public demo sandbox =====
    // demoTenants/{slug}/** is the playable demo state. Open read+write so any
    // /demo visitor can interact without sign-up. Production data lives under
    // tenants/{tid}/** and is locked down separately above.
    match /demoTenants/{slug}/{document=**} {
      allow read, write: if true;
    }
  }
}
