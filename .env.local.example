# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Client SDK (legacy — will be removed after migration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (legacy — will be removed after migration)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend (always the email send engine)
RESEND_API_KEY=
# Override the From address — useful in dev before your sender domain is verified.
# Use "onboarding@resend.dev" for instant demos (Resend will only deliver to the
# email registered to your Resend account in that case).
EMAIL_FROM=

# Vercel Cron secret
CRON_SECRET=

# Brevo (optional — opportunistic one-way pull only; only firms with a Brevo subscription)
BREVO_ENCRYPTION_KEY=

# Stripe (reserved — mock checkout for now)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App / domain map
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=app.sequence-ai.com
NEXT_PUBLIC_MARKETING_DOMAIN=www.sequence-ai.com
