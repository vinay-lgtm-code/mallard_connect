# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (always the email send engine)
RESEND_API_KEY=
# Override the From address — useful in dev before your sender domain is verified.
# Use "onboarding@resend.dev" for instant demos (Resend will only deliver to the
# email registered to your Resend account in that case).
EMAIL_FROM=

# Vercel Cron secret
CRON_SECRET=

# Brevo (optional — opportunistic one-way pull only; only firms with a Brevo subscription)
BREVO_ENCRYPTION_KEY=

# Stripe (reserved — mock checkout for now)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App / domain map
NEXT_PUBLIC_APP_URL=http://localhost:3000
SEQUENCE_ADMIN_EMAILS=vinay@getlegaci.com,divya@getlegaci.com
NEXT_PUBLIC_APP_DOMAIN=app.sequence-ai.com
NEXT_PUBLIC_MARKETING_DOMAIN=www.sequence-ai.com

# Feature flags
# Set to "true" to enable Cadences and Templates features
NEXT_PUBLIC_ENABLE_CADENCES_TEMPLATES=
# Set to "true" to enable the Document Vault on lead detail
NEXT_PUBLIC_ENABLE_DOCUMENTS=
